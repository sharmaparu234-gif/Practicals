
class Book {
    String title;
    String author;
    double price;

    // No-argument constructor  or Default constructor
    Book() {
        title = "Unknown";
        author = "Unknown";
        price = 0.0;
    }

    // Parameterized constructor
    Book(String title, String author, double price) {
        this.title = title;
        this.author = author;
        this.price = price;
    }

    // Copy constructor
    Book(Book other) {
        this.title = other.title;
        this.author = other.author;
        this.price = other.price;
    }
    void display() {
        System.out.println("Title: " + title);
        System.out.println("Author: " + author);
        System.out.println("Price: Rs. " + price);
        System.out.println("--------------------");
    }
}

public class Practical6 {
    public static void main(String[] args) {

        Book b1 = new Book();

        Book b2 = new Book("Java Programming", "James", 500.0);

        Book b3 = new Book(b2);

        System.out.println("Book 1:");
        b1.display();

        System.out.println("Book 2:");
        b2.display();

        System.out.println("Book 3 (Copied Book):");
        b3.display();

        b3.price = 600.0;

        System.out.println("After modifying copied book:");
        System.out.println("Original Book Price: " + b2.price);
        System.out.println("Copied Book Price: " + b3.price);
    }
}
